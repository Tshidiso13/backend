generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Audience {
  WOMEN
  MEN
  UNISEX
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  RESTOCK
  ORDER
  RESERVATION
  RELEASE
  RETURN
  ADJUSTMENT
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  PACKING
  READY_FOR_SHIPMENT
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED

  // temporary legacy values
  PENDING
  PAYMENT_PENDING
  PAID
  DISPUTED
}

enum PaymentStatus {
  PENDING
  COMPLETE
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  // temporary legacy value
  PAID
}
enum PaymentMethod {
  PAYFAST
  CASH_ON_DELIVERY
}

enum PaymentProvider {
  PAYFAST
}

enum ShippingProvider {
  ARAMEX
  PAXI
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  ORDER
  PAYMENT
  INVENTORY
  DISPUTE
  DELIVERY
  CUSTOMER
  SYSTEM
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum SupportCategory {
  ORDER
  DELIVERY
  PAYMENT
  ACCOUNT
  PRODUCT
  RETURNS
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum SupportSender {
  CUSTOMER
  ADMIN
}


/**
 * =========================================================
 * USER
 * =========================================================
 */

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String?
  googleId     String? @unique
  imageUrl     String?

  role   UserRole   @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses               Address[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  supportTicket SupportTicket[]

  orders            Order[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  notifications     Notification[]
  disputes          Dispute[]
  couponRedemptions CouponRedemption[]

  inventoryMovements InventoryMovement[] @relation("InventoryMovementActor")

  @@index([email])
  @@index([role])
  @@index([status])
}

/**
 * =========================================================
 * AUTH SESSION
 * =========================================================
 */

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

/**
 * =========================================================
 * PASSWORD RESET
 * =========================================================
 */

model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/**
 * =========================================================
 * EMAIL VERIFICATION
 * =========================================================
 */

model EmailVerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/**
 * =========================================================
 * ADDRESS
 * =========================================================
 */

model Address {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label         String?
  recipientName String
  phone         String

  addressLine1 String
  addressLine2 String?

  suburb     String?
  city       String
  province   String
  postalCode String
  country    String  @default("South Africa")

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/**
 * =========================================================
 * PRODUCT
 * =========================================================
 */

model Product {
  id String @id @default(cuid())

  slug String @unique
  name String

  shortDescription String?
  story            String?

  family        String
  concentration String
  audience      Audience

  scentOccasions     String[] @default([])
  scentMoods         String[] @default([])
  scentPersonalities String[] @default([])

  badge  String?
  status ProductStatus @default(DRAFT)

  topNotes   String[] @default([])
  heartNotes String[] @default([])
  baseNotes  String[] @default([])

  feeling   String?
  longevity String?
  sillage   String?
  season    String?

  seoTitle       String?
  seoDescription String?

  images        ProductImage[]
  variants      ProductVariant[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([family])
  @@index([audience])
}

/**
 * =========================================================
 * PRODUCT IMAGE
 * =========================================================
 */

model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  publicId String @unique
  url      String
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, position])
}

/**
 * =========================================================
 * PRODUCT VARIANT
 * =========================================================
 */

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  size String
  sku  String @unique

  price Decimal @db.Decimal(10, 2)

  stock         Int @default(0)
  reservedStock Int @default(0)
  threshold     Int @default(3)

  active Boolean @default(true)

  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  orderItems            OrderItem[]
  cartItems             CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
  @@index([productId])
  @@index([active])
}

/**
 * =========================================================
 * WISHLIST
 * =========================================================
 */

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

/**
 * =========================================================
 * CART
 * =========================================================
 */

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId, createdAt])
  @@index([variantId])
}

/**
 * =========================================================
 * INVENTORY MOVEMENT
 * =========================================================
 * Permanent audit/history of stock changes.
 * Reservations are stored separately in InventoryReservation.
 */

model InventoryMovement {
  id String @id @default(cuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  type InventoryMovementType

  quantity         Int
  previousQuantity Int?
  newQuantity      Int?

  reason String?

  referenceType String?
  referenceId   String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  actorId String?
  actor   User?   @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([orderId])
  @@index([actorId])
  @@index([type])
  @@index([referenceType, referenceId])
}

/**
 * =========================================================
 * INVENTORY RESERVATION
 * =========================================================
 * Used by PayFast checkout:
 * checkout starts:
 * reservedStock += quantity
 * PayFast succeeds:
 * stock -= quantity
 * reservedStock -= quantity
 * status = CONSUMED
 * checkout expires/cancels:
 * reservedStock -= quantity
 * status = RELEASED
 */

model InventoryReservation {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int

  status InventoryReservationStatus @default(ACTIVE)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([variantId])
  @@index([status, expiresAt])
}

/**
 * =========================================================
 * ORDER
 * =========================================================
 * userId is intentionally optional.
 * Guest:
 * userId = null
 * email  = checkout email
 * Authenticated:
 * userId = actual user id
 * Later, after email ownership is verified, eligible guest
 * orders can be linked to the user's account by email.
 */

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email     String
  firstName String
  lastName  String
  phone     String

  addressLine1 String
  addressLine2 String?
  suburb       String
  city         String
  province     String
  postalCode   String
  country      String  @default("South Africa")

  deliveryMethod ShippingProvider

  paxiPointCode String?
  paxiPointName String?

  paymentMethod PaymentMethod

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  shipping Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)
  currency String  @default("ZAR")

  orderStatus OrderStatus @default(PENDING_PAYMENT) @map("status")
  paymentStatus PaymentStatus @default(PENDING)

  reservationExpiresAt DateTime?

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  couponId   String?
  couponCode String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              OrderItem[]
  payment            Payment?
  shipment           Shipment?
  dispute            Dispute?
  reservations       InventoryReservation[]
  inventoryMovements InventoryMovement[]
  couponRedemption   CouponRedemption?

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([couponId])
}

/**
 * =========================================================
 * ORDER ITEM
 * =========================================================
 * Snapshot fields ensure old orders do not change when the
 * current product name/price/image changes later.
 */

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  productName   String
  family        String
  concentration String
  sku           String
  size          String
  imageUrl      String?

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

/**
 * =========================================================
 * PAYMENT
 * =========================================================
 */

model Payment {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider PaymentProvider @default(PAYFAST)

  merchantPaymentId String  @unique
  providerPaymentId String? @unique

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("ZAR")
  status   PaymentStatus @default(PENDING)

  rawResponse Json?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/**
 * =========================================================
 * SHIPPING
 * =========================================================
 */

model Shipment {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider ShippingProvider
  service  String

  trackingNumber String?
  trackingUrl    String?

  collectionPointCode String?
  collectionPointName String?

  status String @default("PENDING")

  externalShipmentId String?
  metadata           Json?

  shippedAt   DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([trackingNumber])
}

/**
 * =========================================================
 * COUPON
 * =========================================================
 */

model Coupon {
  id String @id @default(cuid())

  code        String  @unique
  description String?

  type  CouponType
  value Decimal    @db.Decimal(10, 2)

  minimumSpend    Decimal  @default(0) @db.Decimal(10, 2)
  maximumDiscount Decimal? @db.Decimal(10, 2)

  usageLimit   Int?
  perUserLimit Int  @default(1)

  active Boolean @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  orders      Order[]
  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([active])
}

/**
 * =========================================================
 * COUPON REDEMPTION
 * =========================================================
 */

model CouponRedemption {
  id String @id @default(cuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

/**
 * =========================================================
 * NOTIFICATION
 * =========================================================
 */

model Notification {
  id String @id @default(cuid())

  recipientUserId String?
  recipientUser   User?   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  targetRole UserRole?

  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  title   String
  message String

  href     String?
  metadata Json?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([recipientUserId])
  @@index([targetRole])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

/**
 * =========================================================
 * DISPUTE
 * =========================================================
 */

model Dispute {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status DisputeStatus @default(OPEN)

  reason      String
  description String

  evidenceUrls String[] @default([])

  adminNotes String?
  resolution String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}


model SupportTicket {
  id String @id @default(cuid())

  ticketNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  email String

  category SupportCategory
  subject  String

  orderNumber String?

  status   SupportStatus   @default(OPEN)
  priority SupportPriority @default(NORMAL)

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([priority, updatedAt])
  @@index([ticketNumber])
}

model SupportMessage {
  id String @id @default(cuid())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  sender SupportSender

  senderName  String
  senderEmail String?

  message String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
